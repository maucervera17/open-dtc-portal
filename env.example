# Environment variable template. Copy to .env.local (local) or add each variable in your Vercel project settings.
# (Shipped as env.example; rename to .env.example if you prefer the conventional name.)
# Never commit real values. Everything below is empty on purpose.
# [required] = core app, [optional] = feature-specific. Flags are the literal string "true".

# --- Identity & access ---------------------------------------------------
# [required] Master switch for the portal and the MCP endpoint.
DASH_ENABLED=
# [required] Public origin of your deployment, no trailing slash. Example: https://portal.example.com
DASH_BASE_URL=
# [required] Random string, 32 bytes or more. Signs sessions, MCP keys and the Whisper worker request.
#   Generate one with: openssl rand -base64 48
DASH_SESSION_SECRET=
# [required] Comma-separated emails allowed to sign in (max 20 across the three lists).
DASH_ALLOWED_EMAILS=
# [optional] Extra allowed emails, merged with the list above.
DASH_ADDITIONAL_EMAILS=
DASH_TEAM_EMAILS=
# [optional] Name shown in the UI header, emails, PDFs and AI prompts. Default: DTC Portal
BRAND_NAME=
# [optional] Comma-separated hostnames (no scheme) the "ad vs landing page" review may fetch. Example: shop.example.com
LANDING_HOSTS=

# --- Storage -------------------------------------------------------------
# [required] Upstash Redis (REST). All state lives here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# [optional] Vercel Blob (private store) for archived ad media. Either the token, or the store id with OIDC.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# --- Meta Marketing API --------------------------------------------------
# [required] Numeric ad account id WITHOUT the "act_" prefix. Any currency and time zone: the portal reads them from the account.
META_AD_ACCOUNT_ID=
# [required] Token with ads_read on that account.
META_ACCESS_TOKEN=
# [optional] Graph API version, e.g. v25.0 (default used by the Instagram collector).
META_API_VERSION=
# [optional] Pixel id. If empty, the first pixel of the ad account is used.
META_PIXEL_ID=
# [optional] System-user token; enables Event Match Quality (EMQ) in the pixel view.
META_SYSTEM_USER_TOKEN=
# [optional] Token expiry as YYYY-MM-DD (banner 14 days before) or "never". Empty = no banner.
META_TOKEN_EXPIRES_AT=
# [optional] Set to "false" to skip pixel /stats (needed for pixels shared from another business).
PIXEL_STATS_ENABLED=

# --- Instagram (Social view and social report) ---------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=

# --- Currency and time zone (optional) -------------------------------------
# By default both come from the Meta ad account itself. Set them only to override.
# [optional] ISO 4217 code, e.g. USD, EUR, JPY. Only relabels amounts, it never converts them. Invalid = configuration error.
REPORT_CURRENCY=
# [optional] IANA time zone, e.g. America/New_York. Used for "today", report windows and cron day boundaries. Invalid = configuration error.
# Note: Vercel cron schedules in vercel.json are UTC; adjust them if you want runs at a given local hour.
REPORT_TIMEZONE=
# [optional] Minimum spend (account currency) per window before an ad can be judged. Empty = about USD 15 in your currency.
MIN_SPEND=

# --- Targets used by alerts and the AI analyst (optional) ----------------
# Positive numbers: CPA in account currency, ROAS as a ratio.
TARGET_CPA=
TARGET_ROAS=

# --- AI analyst, chat, memory and daily journal --------------------------
# [optional] "true" enables the daily agent job and the Preguntar chat.
AGENT_ENABLED=
# [optional] "gemini" (default) or "anthropic".
AGENT_PROVIDER=
# [optional] Model id used when AGENT_PROVIDER=anthropic.
AGENT_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# [optional] Gemini model id and ordered, comma-separated fallbacks.
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
# [optional] Legacy single fallback; GEMINI_FALLBACK_MODELS wins when set.
GEMINI_FALLBACK_MODEL=
# [optional] "true" emails the daily recommendations to the allowlisted users (needs RESEND_API_KEY + REPORT_FROM).
AGENT_EMAIL_ENABLED=

# --- Creative intelligence (Inspiracion) ---------------------------------
# [optional] "true" enables the module.
INSPIRATION_ENABLED=
# ScrapeCreators API key. Queries the Meta Ad Library through their paid API.
SCRAPECREATORS_API_KEY=
# [optional] Lifetime cap on provider calls (non-negative integer). Default 60.
INSPIRATION_CALL_LIMIT=
# [optional] "provider": rely on the real prepaid ScrapeCreators balance instead of the local cap.
INSPIRATION_BUDGET_MODE=
# [optional] "true" enables Gemini analysis and production plans (needs GEMINI_API_KEY).
INSPIRATION_AI_ENABLED=
# [optional] "true" lets the daily cron follow brands flagged auto:true.
INSPIRATION_AUTO_ENABLED=
# [internal] "true" flags the library as a read-only preview in the UI. Leave empty.
INSPIRATION_PREVIEW=

# --- Email (Resend): sign-in links and reports ---------------------------
RESEND_API_KEY=
# Verified sender, e.g. "Reports <reports@example.com>".
REPORT_FROM=
# Comma-separated recipients of the scheduled sales report.
REPORT_RECIPIENTS=
# Extra recipients that also receive the social report.
REPORT_SOCIAL_RECIPIENTS=
# Bearer secret for POST /api/report (preview / send).
REPORT_SECRET=
# "true" allows mode=send on /api/report (production deployments only).
REPORT_ENABLED=
# "true" turns on the scheduled report crons; the social one also needs SOCIAL_ENABLED=true.
AUTOMATION_ENABLED=
SOCIAL_ENABLED=
# First delivery dates (YYYY-MM-DD). Sales reports repeat every 3 days, social every 7.
REPORT_START_DATE=
SOCIAL_START_DATE=

# --- Cron & platform -----------------------------------------------------
# [required for crons] Vercel sends it as "Authorization: Bearer <value>" to the cron routes.
CRON_SECRET=
# Set automatically by Vercel (production | preview | development). Do not set by hand.
VERCEL_ENV=
# Set to 1 so Vercel can bundle the Whisper model with the Python function.
VERCEL_SUPPORT_LARGE_FUNCTIONS=

# --- Local MCP bridge (npm run mcp*) -------------------------------------
# Optional overrides for scripts/portal-mcp-bridge.mjs; "npm run mcp:configure" normally stores these in .data/.
DTC_PORTAL_MCP_URL=
DTC_PORTAL_MCP_TOKEN=
# "1" lets the bridge talk to http://127.0.0.1 (tests only).
DTC_MCP_TEST=

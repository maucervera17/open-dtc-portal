{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/social-cron",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/dash-cron?job=snapshot",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/dash-cron?job=agent",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/inspiration-cron",
      "schedule": "0 15 * * *"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    },
    "api/whisper.py": {
      "maxDuration": 300,
      "excludeFiles": "{node_modules/**,public/**,output/**,test/**,scripts/**,.vercel/**}",
      "includeFiles": "services/transcription/model/**"
    }
  },
  "framework": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src https://*.private.blob.vercel-storage.com 'self' data: blob: https://*.fbcdn.net https://*.cdninstagram.com; frame-src https://www.facebook.com https://business.facebook.com https://m.facebook.com https://facebook.com; media-src https://*.private.blob.vercel-storage.com 'self' https://*.fbcdn.net https://*.cdninstagram.com; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/dash/:path*",
      "destination": "/api/dash?r=:path*"
    }
  ],
  "buildCommand": "python3 services/transcription/download_model.py"
}
